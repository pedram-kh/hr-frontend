# Base URL of the hr-backend API (host-exposed by docker-compose / artisan serve).
VITE_API_BASE_URL=http://localhost:8000

# Sprint 12b presentation flags (build-time; see src/lib/featureFlags.ts).
# Code defaults: chunk health OFF, Cobertura nav ON. Dev keeps both visible.
VITE_SHOW_CHUNK_HEALTH=true
VITE_SHOW_COVERAGE=true
